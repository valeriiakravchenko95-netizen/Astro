# Скопируйте этот файл в .env и впишите свой токен.
# Токен выдаёт @BotFather в Telegram по команде /newbot.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательное. Значения ниже — то, что и так стоит по умолчанию.

# Путь к ядру эфемерид, если оно лежит не в ephemeris/
# ASTRO_EPHEMERIS=/путь/к/de440s.bsp

# Система домов: placidus | whole_sign | porphyry
# ASTRO_HOUSE_SYSTEM=placidus

# Управители: traditional | modern
# ASTRO_RULERS=traditional

# Модель средней Лилит: swiss (как в большинстве программ) | meeus
# ASTRO_LILITH=swiss

# Считать ли минорные аспекты
# ASTRO_MINOR_ASPECTS=0

# Соль для идентификатора карты. Без неё идентификатор годится только как
# ключ кеша: пространство дат и мест мало, и хеш перебирается за минуты.
# ASTRO_HASH_SALT=
